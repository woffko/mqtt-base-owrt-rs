{
	"luci-app-mqtt-metrics": {
		"description": "Grant access to MQTT Metrics",
		"read": {
			"ubus": {
				"mqtt-metrics": [ "status", "catalog", "preview", "log" ]
			},
			"uci": [ "mqtt-metrics" ]
		},
		"write": {
			"ubus": {
				"mqtt-metrics": [ "test_connection", "set_password", "republish", "purge", "reload" ]
			},
			"uci": [ "mqtt-metrics" ]
		}
	}
}
