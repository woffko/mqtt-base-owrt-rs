#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/mqtt-metricsd
CONFIG=mqtt-metrics

prepare_dirs() {
	mkdir -p /var/run/mqtt-metrics /etc/mqtt-metrics
	chmod 0700 /var/run/mqtt-metrics /etc/mqtt-metrics
	[ -f /etc/config/$CONFIG ] && chmod 0600 /etc/config/$CONFIG
	[ -f /etc/mqtt-metrics/secret ] && chmod 0600 /etc/mqtt-metrics/secret
	return 0
}

service_enabled() {
	local enabled
	config_load "$CONFIG"
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ]
}

start_service() {
	service_enabled || return 0
	prepare_dirs

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}

# Keep the MQTT connection on configuration changes: the daemon re-reads UCI
# on SIGHUP and reconnects only when broker settings changed.
reload_service() {
	if ! service_enabled; then
		stop
	elif procd_running "$CONFIG"; then
		procd_send_signal "$CONFIG" '*' HUP
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
