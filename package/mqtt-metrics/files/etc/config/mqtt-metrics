
config main 'main'
	option enabled '1'
	option log_level 'info'

config broker 'broker'
	option host ''
	option port '1883'
	option username ''
	option client_id ''
	option keepalive '60'
	option qos '1'
	option retain '1'
	option tls '0'

config identity 'identity'
	option base_topic 'openwrt'
	option node ''
	option discovery '1'
	option discovery_prefix 'homeassistant'
	option birth '1'
	option birth_topic 'homeassistant/status'
	option device_id ''
	option device_name ''
	option manufacturer 'OpenWrt'
	option model 'Router'
	option cleanup_legacy '1'

config publish 'publish'
	option interval '300'
	option change_only '0'
	option max_age '3600'

config select 'select'
	option interfaces 'auto'
